      ],
      "id": "f68f9666-da60-48f6-9a8c-097cb2059ee5",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// tra ngược metadata từ node sinh query\nconst meta = new Map();\nfor (const it of $('Code in JavaScript').all()) {\n  meta.set(it.json.query, it.json);\n}\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const raw = item.json.data;\n  if (!raw) continue;\n\n  let parsed;\n  try { parsed = JSON.parse(raw); } catch { continue; }\n\n  const srcQuery = parsed[0];\n  const suggestions = parsed[1] || [];\n  const m = meta.get(srcQuery) || {};\n\n  suggestions.forEach((s, i) => {\n    const kw = String(s).toLowerCase().trim();\n    if (!kw) return;\n\n    out.push({ json: {\n      keyword:      kw,\n      word_count:   kw.split(/\\s+/).length,\n      position:     i + 1,\n      source_query: srcQuery,\n      line:         m.line   || '',\n      gl:           m.gl     || '',\n      kw_id:        m.kw_id  || '',\n      pillar:       m.pillar || '',\n      seed:         m.seed   || '',\n    }});\n  });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        80
      ],
      "id": "92179cd1-de16-4666-af3c-abdedbc243de",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const map = new Map();\n\nfor (const item of $input.all()) {\n  const kw = String(item.json.keyword || '').trim();\n  if (kw.length < 4) continue;\n\n  const pos = Number(item.json.position) || 0;\n\n  if (map.has(kw)) {\n    const e = map.get(kw);\n    e.hit_count += 1;      // đếm số lần trùng\n    e.pos_sum   += pos;    // cộng dồn vị trí để tính trung bình\n    continue;\n  }\n\n  map.set(kw, {\n    keyword:    kw,\n    hit_count:  1,\n    pos_sum:    pos,\n    word_count: kw.split(/\\s+/).length,\n  });\n}\n\nconst rows = [...map.values()].map(e => {\n  const avg = Math.round((e.pos_sum / e.hit_count) * 10) / 10;  // vị trí trung bình\n  return {\n    keyword:     e.keyword,\n    pos_display: `${avg}-${e.hit_count}`,   // \"trung bình - số lần\", vd 1.2-8\n    word_count:  e.word_count,\n  };\n});\n\n// từ nào xuất hiện nhiều lần hơn thì lên trên\nrows.sort((a, b) =>\n  Number(b.pos_display.split('-')[1]) - Number(a.pos_display.split('-')[1])\n);\n\nreturn rows.map(json => ({ json }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
