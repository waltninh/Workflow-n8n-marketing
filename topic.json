    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst data = input.output ?? input;\n\nconst clusters = data.clusters || [];\n\nif (clusters.length === 0) {\n  throw new Error('Không có cluster nào từ AI Agent3');\n}\n\nlet lines = [];\nlet totalKeywords = 0;\n\nfor (const c of clusters) {\n  const topic = c.topic || '(no topic)';\n  const kws = c.keywords || [];\n  totalKeywords += kws.length;\n\n  lines.push(`### ${topic}`);\n  kws.forEach(k => lines.push(k));\n  lines.push('');\n}\n\nreturn [{\n  json: {\n    total_clusters: clusters.length,\n    total_keywords: totalKeywords,\n    list: lines.join('\\n'),\n  }\n}];"
      },
