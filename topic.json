      "parameters": {
        "jsCode": "// Tách mỗi cluster thành 1 item riêng để append vào Google Sheet\n\nconst input = $input.first().json;\nconst data = input.output ?? input;\n\nconst clusters = data.clusters || [];\n\nif (clusters.length === 0) {\n  throw new Error('Không có cluster nào ở input');\n}\n\nreturn clusters.map((c, i) => ({\n  json: {\n    group_id: `G${String(i + 1).padStart(2, '0')}`,\n    topic: c.topic || '',\n    keyword_count: (c.keywords || []).length,\n    keywords: (c.keywords || []).join('\\n'),   // xuống dòng trong 1 ô Sheet\n  }\n}));"
