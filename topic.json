      "id": "0b2ee46f-eca7-4b0f-999c-3ce920f00607",
      "name": "Code in JavaScript4"
    },
    {
      "parameters": {
        "jsCode": "// Gom tất cả từ khóa thành 1 khối text duy nhất để đưa vào AI Agent\n\nconst rows = $input.all().map(i => i.json);\n\nif (rows.length === 0) {\n  throw new Error('Không có từ khóa nào ở input');\n}\n\n// Nếu item có field \"keyword\" (từ Code in JavaScript4) thì dùng nó,\n// nếu không có thì thử field \"keywords\" (đã gộp sẵn) hoặc fallback\nconst list = rows.map((r, i) => {\n  const kw = r.keyword || r.keywords || '';\n  return `${i + 1}. ${kw}`;\n}).join('\\n');\n\nreturn [{\n  json: {\n    total: rows.length,\n    list: list,       // dùng field này trong Prompt: {{ $json.list }}\n  }\n}];"
      },
