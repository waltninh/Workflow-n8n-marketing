    {
      "parameters": {
        "jsCode": "const letters = 'abcdefghijklmnopqrstuvwxyz'.split('');\nconst digits  = '0123456789'.split('');\n\n// Modifier thương mại / B2B — chạy CẢ HAI chiều\n// (\"wholesale frozen avocado\" và \"frozen avocado wholesale\" đều tự nhiên)\nconst b2b = ['supplier','manufacturer','exporter','wholesale','bulk',\n  'oem','odm','private label','moq','factory','price','fob',\n  'distributor','importer','in brine','in syrup','certification',\n  'hs code','from vietnam','bulk order'];\n\n// Từ mở đầu câu hỏi — CHỈ đứng TRƯỚC seed\n// (\"is frozen avocado healthy\" hợp lý, \"frozen avocado is\" thì không)\nconst b2cPrefix = ['is','are','can you','can i','how to','how do you',\n  'what is','what are','why','when','where','which','does','do','should',\n  'how long','how much','how many','best','top','benefits of','who'];\n\n// Thuộc tính & giới từ — CHỈ đứng SAU seed\n// (\"frozen avocado recipe\" hợp lý, \"recipe frozen avocado\" thì không)\nconst b2cSuffix = ['recipe','recipes','calories','nutrition','benefits',\n  'healthy','vs','substitute','alternative','review','for','with',\n  'without','and','like','near me','brand','taste','storage','uses',\n  'ideas','types','size','organic'];\n\nconst out = [];\n\nfor (const row of $input.all()) {\n  // chuẩn hóa toàn bộ tên cột về chữ thường\n  const r = {};\n  for (const [k, val] of Object.entries(row.json)) {\n    r[String(k).trim().toLowerCase()] = val;\n  }\n\n  // LƯU Ý: phải đọc bằng key chữ thường, khớp với bước chuẩn hóa ở trên\n  const seed = String(r['seed'] || '').toLowerCase().trim();\n  if (!seed) continue;\n\n  // đọc geolocation từ sheet: \"us\" hoặc \"us, de, ae\"\n  const markets = String(r['geolocation'] || 'us')\n    .split(/[,;/|]/)\n    .map(x => x.trim().toLowerCase())\n    .filter(x => /^[a-z]{2}$/.test(x));\n\n  if (markets.length === 0) markets.push('us');\n\n  for (const gl of markets) {\n    const v = new Map();\n\n    // alphabet soup: a-z, thêm 0-9 để bắt biến thể khối lượng/quy cách\n    // (vd \"frozen avocado 1kg\", \"frozen avocado 500g\")\n    letters.forEach(l => v.set(`${seed} ${l}`, 'discovery'));\n    digits.forEach(d  => v.set(`${seed} ${d}`, 'discovery'));\n\n    b2cPrefix.forEach(k => v.set(`${k} ${seed}`, 'B2C'));\n    b2cSuffix.forEach(k => v.set(`${seed} ${k}`, 'B2C'));\n\n    // set b2b sau cùng: nếu trùng key với b2c thì nhãn B2B thắng\n    b2b.forEach(k => {\n      v.set(`${seed} ${k}`, 'B2B');\n      v.set(`${k} ${seed}`, 'B2B');\n    });\n\n    ['vietnam','supplier','price'].forEach(k =>\n      v.set(`${seed} * ${k}`, 'B2B'));\n\n    for (const [q, line] of v) {\n      out.push({ json: {\n        kw_id:  r['kw_id'] || '',\n        pillar: r['pillar topic'] || r['seed'] || '',\n        seed,\n        query:  q,\n        line,\n        gl,\n        hl: 'en',\n      }});\n    }\n  }\n}\n\nif (out.length === 0) {\n  throw new Error('Không sinh được query nào — kiểm tra cột \"Seed\" và \"Geolocation\" trong sheet (Seed không được để trống)');\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
